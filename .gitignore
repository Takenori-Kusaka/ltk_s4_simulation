# 依存関係
node_modules/
__pycache__/
.venv/
venv/
vendor/bin/

# ビルド成果物
dist/
build/
target/
*.egg-info/

# カバレッジの出力(G-5 の test ジョブが毎回作る。coverage-check が読む)
coverage/
.nyc_output/
coverage.json
coverage.out

# 出荷判定の証跡(タグ push 時に CI が生成する)
evidence/

# 秘匿情報。強制層の設定でも参照を遮断するが、混入の経路をここでも塞ぐ
.env
.env.*
!.env.example
*.pem
*.key

# Riot API の生の応答と収集ログ(F-003。公開しない。公開するのは集計値だけ)
data/raw/
# 価値責任者が共有する配信の文字起こしと、その前処理の出力(第三者の著作物。要約だけを docs/research/grounds/ に置く)
data/transcript/

# エディタ・OS
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json

# 一時領域
tmp/
.cache/
*.log

# Graft のローカルグラフキャッシュ。再生成できるため commit しない(`graft build` で作る)
/graft/

# 自己修正ループのロック(scripts/gate/self-heal.mjs が作る。端末ごとの状態)
.claude/.self-heal

actions-runner/